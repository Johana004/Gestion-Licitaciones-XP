@model IEnumerable<Licitaciones.Domain.Entities.Oferta>

@{
    ViewData["Title"] = "Listado de Ofertas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-card-checklist"></i> Ofertas Presentadas</h2>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>ID Oferta</th>
                <th>Monto Ofertado</th>
                <th>Fecha Presentación</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center py-4 text-muted">
                        No hay ofertas registradas actualmente.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var oferta in Model)
                {
                    <tr>
                        <td>@oferta.Id</td>
                        <td>
                            <span class="monto-convertible" data-monto-crc="@oferta.MontoOfertadoCRC">
                                ₡@oferta.MontoOfertadoCRC.ToString("N2")
                            </span>
                        </td>
                        <td>@oferta.FechaPresentacion.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>