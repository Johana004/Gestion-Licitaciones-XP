@model Licitaciones.Domain.Entities.Licitacion

@{
    ViewData["Title"] = "Detalle de Licitación";
}

<div class="container my-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-file-earmark-text"></i> Licitación: @Model.Codigo
            </h4>
            <a asp-action="Index" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left"></i> Volver al Listado
            </a>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Título / Objeto:</div>
                <div class="col-md-9">@Model.Titulo</div>
            </div>
            
            <hr />

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Presupuesto Estimado:</div>
                <div class="col-md-9">
                    <span class="monto-convertible fs-5 fw-semibold text-success" data-monto-crc="@Model.PresupuestoEstimadoCRC">
                        ₡@Model.PresupuestoEstimadoCRC.ToString("N2")
                    </span>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Fecha de Cierre:</div>
                <div class="col-md-9">
                    <i class="bi bi-calendar-event"></i> @Model.FechaCierre.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-controller="Ofertas" asp-action="Crear" asp-route-licitacionId="@Model.Id" class="btn btn-success">
                <i class="bi bi-send-check"></i> Presentar Oferta
            </a>
        </div>
    </div>
</div>