@model Licitaciones.Web.Controllers.CrearLicitacionModel

@{
    ViewData["Title"] = "Nueva Licitación";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Registrar Nueva Licitación</h4>
            </div>
            <div class="card-body">
                <form asp-action="Crear" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Código de Licitación</label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: LIC-2026-001" required />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Título / Objeto de Contratación</label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej: Adquisición de Licencias de Software" required />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Presupuesto Estimado (CRC)</label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="PresupuestoEstimadoCRC" class="form-control" type="number" step="0.01" placeholder="15000000.00" required />
                        </div>
                        <span asp-validation-for="PresupuestoEstimadoCRC" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Fecha y Hora de Cierre</label>
                        <input asp-for="FechaCierre" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="FechaCierre" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Guardar Licitación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>