@model IEnumerable<Licitaciones.Domain.Entities.Licitacion>

@{
    ViewData["Title"] = "Listado de Licitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Licitaciones Publicadas</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva Licitación
    </a>
</div>

<!-- Filtros de Búsqueda -->
<form method="get" class="card card-body mb-4 shadow-sm">
    <div class="row g-3">
        <div class="col-md-8">
            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por código o título..." />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-secondary w-100">
                <i class="bi bi-search"></i> Filtrar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<!-- Tabla de Resultados -->
<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Título</th>
                <th>Presupuesto Estimado</th>
                <th>Fecha Cierre</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox display-6 d-block mb-2"></i>
                        No se encontraron licitaciones registradas.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var licitacion in Model)
                {
                    <tr>
                        <td class="fw-bold">@licitacion.Codigo</td>
                        <td>@licitacion.Titulo</td>
                        <td>
                            <span class="monto-convertible fw-semibold" data-monto-crc="@licitacion.PresupuestoEstimadoCRC">
                                ₡@licitacion.PresupuestoEstimadoCRC.ToString("N2")
                            </span>
                        </td>
                        <td>@licitacion.FechaCierre.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <a asp-action="Detalle" asp-route-id="@licitacion.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Ver Detalles
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>