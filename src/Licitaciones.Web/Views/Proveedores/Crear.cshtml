@model Licitaciones.Web.Models.ProveedorViewModel

@{
    ViewData["Title"] = "Registrar Proveedor";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-building-add"></i> Registrar Nuevo Proveedor</h4>
            </div>
            <div class="card-body">
                <form asp-action="Crear" method="post">
                    <div class="mb-3">
                        <label asp-for="CedulaJuridica" class="form-label fw-bold"></label>
                        <input asp-for="CedulaJuridica" class="form-control" placeholder="Ej: 3-101-000000" />
                        <span asp-validation-for="CedulaJuridica" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreRazonSocial" class="form-label fw-bold"></label>
                        <input asp-for="NombreRazonSocial" class="form-control" placeholder="Ej: Empresa S.A." />
                        <span asp-validation-for="NombreRazonSocial" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EmailContacto" class="form-label fw-bold"></label>
                        <input asp-for="EmailContacto" class="form-control" type="email" placeholder="contacto@empresa.com" />
                        <span asp-validation-for="EmailContacto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-bold"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ej: 2460-0000" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Guardar Proveedor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>